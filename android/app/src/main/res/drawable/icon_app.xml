<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

  <!-- 书本封面 -->
  <rect x="25" y="15" width="50" height="70" rx="8" ry="8"
        fill="none" stroke="#000000" stroke-width="4"
        stroke-linecap="round" stroke-linejoin="round"/>

  <!-- 书脊 -->
  <line x1="35" y1="15" x2="35" y2="85"
        stroke="#000000" stroke-width="4"
        stroke-linecap="round"/>

  <!-- 书页线条 -->
  <line x1="45" y1="35" x2="65" y2="35"
        stroke="#000000" stroke-width="4"
        stroke-linecap="round"/>
  <line x1="45" y1="50" x2="65" y2="50"
        stroke="#000000" stroke-width="4"
        stroke-linecap="round"/>
  <line x1="45" y1="65" x2="58" y2="65"
        stroke="#000000" stroke-width="4"
        stroke-linecap="round"/>
</vector>
